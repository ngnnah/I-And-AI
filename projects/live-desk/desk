#!/usr/bin/env python3
"""desk: the live desk's per-turn reads in one command, plus creating a desk.

The live desk rules (~/.claude/rules/live-desk.md) have the main session, every
turn, get the time, run the rules' open-answer grep and look up line numbers in
its desk. Chained into one shell command, those match no allow rule, so each
turn stopped for an approval. This script does them as one allow-listed call:

    desk check <file>      time, open answers, ticked items, Status's line numbers, last entry
    desk line <file> <n>   line number of entry n
    desk new <topic> ...   create a desk in this month's folder and open it in Obsidian
    desk open <file>       show a desk in Obsidian: its open tab, else a new tab

Writes to an existing desk stay on the Edit tool, never this script: Edit
refuses a write when the file changed since Claude read it, which catches an
answer typed on the phone mid-turn, and the desk guard hook (desk-nudge.sh)
sees only Edit and Write. `desk new` is the one write, and only to a file that
doesn't exist yet (plus its month folder, when that doesn't exist either).
"""

# WHY: macOS's own python3 is 3.9, which can't evaluate `str | None` at runtime.
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from datetime import datetime
from pathlib import Path
from urllib.parse import quote

# Desk-name aliases for repo folders, for short desk names: {"my-long-repo": "MLR"}
# names my-long-repo's desks 2026-10/28-MLR-<topic>.md. A folder not listed keeps
# its own name. If you add any, name them in the rules' first bullet too.
REPO_ALIASES = {}

# Obsidian's own CLI (1.12+), on when Settings > General > Advanced > Command
# line interface is. DESK_OBSIDIAN_CLI points elsewhere, for a test stub.
OBSIDIAN_CLI = os.environ.get("DESK_OBSIDIAN_CLI") or "/Applications/Obsidian.app/Contents/MacOS/obsidian-cli"

# Runs inside Obsidian through its CLI: switch to the tab already showing the
# desk, else open it in a new tab. getViewState() also sees tabs Obsidian hasn't
# loaded yet, and the wait covers a desk created a moment ago that the vault
# hasn't indexed.
SHOW_DESK_JS = (
    "(async () => {{ const path = {path}, ws = app.workspace; let leaf = null;"
    " ws.iterateAllLeaves(l => {{ if (!leaf && l.getViewState().state?.file === path) leaf = l; }});"
    " if (leaf) {{ ws.setActiveLeaf(leaf, {{ focus: true }}); await ws.revealLeaf(leaf); return 'switched'; }}"
    " let file = app.vault.getFileByPath(path);"
    " for (let i = 0; !file && i < 30; i++) {{ await sleep(100); file = app.vault.getFileByPath(path); }}"
    " if (!file) return 'missing';"
    " await ws.getLeaf('tab').openFile(file, {{ active: true }}); return 'opened'; }})()"
)

# NOTE: copied verbatim from the rules' "Find my open answers" block, which stays
# the definition; change the two together.
OPEN_ANSWER_PATTERN = r"(^|[^`])>>[^✓]*$"

# Status's sections in order, each as (name, name before the rename). Desks
# written before Immediate actions and Later existed keep Open questions and
# Next, so check falls back to those.
STATUS_SECTIONS = (
    ("Now",),
    ("Immediate actions", "Open questions"),
    ("Later", "Next"),
    ("Decisions",),
    ("Done",),
)
# WHY: no H1. Obsidian shows the file name as the note's title, so a heading
# above Abstract would only repeat it.
SKELETON = """## Abstract
{abstract}

## Status · updated {stamp}

### Now
> [!info] Working
> {now}

### Immediate actions
None.

### Later

### Decisions

### Done

## Log
"""


def stamp() -> str:
    """Local time in the rules' heading format, MM-DD HH:MM."""
    return datetime.now().strftime("%m-%d %H:%M")


def die(msg: str, code: int = 1) -> None:
    """Print an error to stderr and exit."""
    print(f"desk: {msg}", file=sys.stderr)
    sys.exit(code)


def read_lines(path: str) -> list[str]:
    """The desk's lines, or exit if it can't be read."""
    try:
        return Path(path).read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError as e:
        die(f"can't read {path}: {e.strerror}")


def headings(lines: list[str]):
    """Yield (line number, text) for each line outside fenced code blocks."""
    fenced = False
    for no, text in enumerate(lines, 1):
        if text.lstrip().startswith(("```", "~~~")):
            fenced = not fenced
        elif not fenced:
            yield no, text


def open_answers(path: str) -> list[str]:
    """The rules' grep, run as is: its output lines, `<line>:<text>`."""
    env = dict(os.environ)
    ctype = (env.get("LC_ALL") or env.get("LC_CTYPE") or env.get("LANG") or "").lower()
    if "utf-8" not in ctype and "utf8" not in ctype:
        # WHY: [^✓] means "any character but ✓" only in a UTF-8 locale; in C it
        # excludes ✓'s three bytes, so an answer holding an em dash goes unseen.
        env["LC_ALL"] = "en_US.UTF-8"
    run = subprocess.run(
        ["/usr/bin/grep", "-nE", OPEN_ANSWER_PATTERN, path], capture_output=True, env=env
    )
    if run.returncode > 1:
        die(f"grep failed: {run.stderr.decode(errors='replace').strip()}", 2)
    return run.stdout.decode("utf-8", errors="replace").splitlines()


def entries(lines: list[str]) -> list[tuple[int, int, bool]]:
    """(entry number, line, @ form) for each entry heading: `### @<n> ` or `### <n> ·`."""
    found = []
    for no, text in headings(lines):
        m = re.match(r"### @(\d+) |### (\d+) ·", text)
        if m:
            found.append((int(m.group(1) or m.group(2)), no, m.group(1) is not None))
    return found


def cmd_check(args: argparse.Namespace) -> None:
    """Print the time, open answers, ticked items, Status's line numbers and the last entry."""
    lines = read_lines(args.file)
    out = [f"now: {stamp()}"]
    answers = open_answers(args.file)
    out.append(f"open answers: {len(answers) or 'none'}")
    out += answers

    abstract = status = log = None
    sections, ticked = {}, []
    for no, text in headings(lines):
        if text.startswith("## Log"):
            log = no
            break
        if abstract is None and text.startswith("## Abstract"):
            abstract = no
        if status is None and text.startswith("## Status"):
            status = f"line {no} {text[len('## Status'):].strip()}".rstrip()
        for names in STATUS_SECTIONS:
            for name in names:
                if name not in sections and re.match(rf"### {name}\b", text):
                    sections[name] = no
        # WHY: a checkbox survives in Status only on a bare yes/no item, so a
        # tick anywhere there is an answer, whichever section holds it.
        if status is not None and re.match(r"\s*[-*+] \[[xX]\](\s|$)", text):
            ticked.append(f"{no}:{text}")
    out.append(f"ticked items: {len(ticked) or 'none'}")
    out += ticked
    out.append(f"status: {status or 'missing'}")
    parts = [f"Abstract {abstract or 'missing'}"]
    for names in STATUS_SECTIONS:
        # NOTE: the current name wins over the old one; a section under neither
        # is reported missing under its current name.
        name = next((n for n in names if n in sections), names[0])
        parts.append(f"{name} {sections.get(name, 'missing')}")
    out.append("sections: " + ", ".join(parts + [f"Log {log or 'missing'}"]))

    found = entries(lines)
    last = f"§{found[-1][0]} at line {found[-1][1]}" if found else "none"
    out.append(f"last entry: {last} · file: {len(lines)} lines")
    print("\n".join(out))


def cmd_line(args: argparse.Namespace) -> None:
    """Print the line number of entry n, preferring the `### @<n> ` form."""
    found = entries(read_lines(args.file))
    for at_form in (True, False):
        for n, no, at in found:
            if n == args.n and at == at_form:
                print(no)
                return
    die(f"no entry {args.n} in {args.file}")


def repo_name(explicit: str | None) -> str:
    """The desk name's repo part: --repo, else the current git repo's folder."""
    name = explicit
    if not name:
        git = subprocess.run(
            ["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
            capture_output=True,
            text=True,
        )
        if git.returncode != 0:
            die("not in a git repo; pass --repo <name>")
        common = Path(git.stdout.strip())
        # WHY: the common dir's parent is the main checkout, so a worktree's desk
        # is named for its repo, not for the worktree folder.
        if common.name == ".git":
            name = common.parent.name
        else:
            top = subprocess.run(
                ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True
            )
            name = Path(top.stdout.strip()).name
    return REPO_ALIASES.get(name, name)


def cmd_new(args: argparse.Namespace) -> None:
    """Create a desk from the rules' skeleton in its month folder, open it in Obsidian, print its path."""
    if not re.fullmatch(r"[a-z0-9]+(-[a-z0-9]+)*", args.topic):
        die(f"topic must be kebab-case (lowercase words joined by -): {args.topic!r}")
    home = Path(os.environ.get("DESK_HOME") or Path.home())
    folder = home / ("claude-replies-personal" if args.personal else "claude-replies")
    if not folder.is_dir():
        die(f"no desk folder at {folder}")
    # NOTE: one clock read for both, so a desk made at midnight on the 1st
    # lands in the month its own day belongs to.
    now = datetime.now()
    month = folder / f"{now:%Y-%m}"
    try:
        month.mkdir(exist_ok=True)
    except OSError as e:
        die(f"can't create {month}: {e.strerror}")
    # WHY: the month folder holds the year and month, so the name starts at the day.
    name = f"{now:%d}-{repo_name(args.repo)}-{args.topic}.md"
    path = month / name
    try:
        with path.open("x", encoding="utf-8") as f:
            f.write(SKELETON.format(abstract=args.abstract, stamp=stamp(), now=args.now))
    except FileExistsError:
        die(f"{path} already exists; continue it with the Edit tool")
    if not args.no_open:
        try:
            show_in_obsidian(path)
        except SystemExit:
            print("desk: created, but not opened in Obsidian", file=sys.stderr)
    print(path)


def vault_of(path: Path) -> Path:
    """The Obsidian vault holding the desk: the nearest folder with .obsidian."""
    # WHY: the desk folder may be a symlink into the vault, so the vault is
    # found from the resolved path.
    for folder in path.resolve().parents:
        if (folder / ".obsidian").is_dir():
            return folder
    die(f"{path} is not in an Obsidian vault")


def open_tabs(vault: Path) -> set[str]:
    """Vault paths of the files in the vault's tabs, from Obsidian's last saved layout."""
    try:
        layout = json.loads((vault / ".obsidian" / "workspace.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return set()
    files, stack = set(), [layout.get("main", {})]
    while stack:
        node = stack.pop()
        if node.get("type") == "leaf":
            files.add(node.get("state", {}).get("state", {}).get("file"))
        stack += node.get("children", [])
    return files


def show_in_obsidian(path: Path) -> str:
    """Show the desk in Obsidian without replacing the tab in front; return what happened."""
    vault = vault_of(path)
    rel = path.resolve().relative_to(vault).as_posix()
    js = SHOW_DESK_JS.format(path=json.dumps(rel))
    try:
        run = subprocess.run(
            [OBSIDIAN_CLI, f"vault={vault.name}", "eval", f"code={js}"],
            capture_output=True,
            text=True,
            timeout=15,
        )
        result = run.stdout.strip().splitlines()[-1:] or [""]
    except (OSError, subprocess.TimeoutExpired):
        result = [""]
    if result[0] == "=> missing":
        die(f"Obsidian has no {rel} in the {vault.name} vault")
    if result[0] in ("=> switched", "=> opened"):
        subprocess.run(["open", "-a", "Obsidian"], capture_output=True)
        return "switched to its tab" if result[0] == "=> switched" else "opened in a new tab"
    # The CLI is off, or Obsidian didn't answer. `open -a Obsidian <file>` and
    # a plain obsidian://open both load the desk into the tab in front,
    # replacing it, so: leave an open desk where it is, else a new tab.
    if rel in open_tabs(vault):
        subprocess.run(["open", "-a", "Obsidian"], capture_output=True)
        return (
            "already in a tab, not switched to: Obsidian's CLI is off "
            "(Settings > General > Advanced > Command line interface)"
        )
    url = f"obsidian://open?vault={quote(vault.name)}&file={quote(rel)}&paneType=tab"
    if subprocess.run(["open", url], capture_output=True).returncode != 0:
        die("open obsidian://open failed")
    return "opened in a new tab"


def cmd_open(args: argparse.Namespace) -> None:
    """Show an existing desk in Obsidian and say how."""
    path = Path(args.file).expanduser()
    if not path.is_file():
        die(f"no desk at {path}")
    print(f"{path}: {show_in_obsidian(path)}")


def main() -> None:
    """Parse the subcommand and run it."""
    parser = argparse.ArgumentParser(
        prog="desk", description="Live desk reads (check, line) and desk creation (new)."
    )
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser(
        "check",
        help="time, open answers, ticked items, Status line numbers, last entry",
        description="Print the time (MM-DD HH:MM), every open answer (the rules' grep, "
        "as <line>:<text>), every ticked checkbox line in Status (as <line>:<text>), "
        "the Abstract's and Status's heading line numbers, under the names found (Open questions and Next "
        "on desks from before the rename), and the last entry.",
    )
    p.add_argument("file", help="the desk")
    p.set_defaults(func=cmd_check)

    p = sub.add_parser(
        "line",
        help="line number of entry n",
        description="Print the line of entry n's heading (### @<n> , or the older "
        "### <n> ·). Exits 1 if there is none.",
    )
    p.add_argument("file", help="the desk")
    p.add_argument("n", type=int, help="entry number")
    p.set_defaults(func=cmd_line)

    p = sub.add_parser(
        "new",
        help="create a desk and open it",
        description="Create <YYYY-MM>/<DD>-<repo>-<topic>.md in ~/claude-replies "
        "(or ~/claude-replies-personal), making the month folder if it's missing, with "
        "the rules' skeleton, open it in Obsidian and print its path. Refuses an existing "
        "file. DESK_HOME overrides ~ for both folders.",
    )
    p.add_argument("topic", help="kebab-case topic")
    p.add_argument("--repo", help="repo part of the name (default: the current git repo)")
    p.add_argument("--personal", action="store_true", help="use ~/claude-replies-personal")
    p.add_argument("--abstract", default="To come.", help="the desk's goal, one to three lines")
    p.add_argument("--now", default="Starting.", help="first Status → Now text")
    p.add_argument("--no-open", action="store_true", help="don't open it in Obsidian")
    p.set_defaults(func=cmd_new)

    p = sub.add_parser(
        "open",
        help="show a desk in Obsidian",
        description="Switch Obsidian to the desk's tab, or open it in a new tab; the tab in "
        "front is never replaced. Switching needs Obsidian's CLI (Settings > General > "
        "Advanced); without it a desk that's already in a tab is left there.",
    )
    p.add_argument("file", help="the desk")
    p.set_defaults(func=cmd_open)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
